{
  "manifest_version": 3,
  "name": "XBBridge",
  "short_name": "XBBridge",
  "version": "0.3.4",
  "description": "Let a local CLI agent work in your own Edge tabs: named tab groups, visible control markers, tab leases. CLI: xb",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "windows",
    "scripting",
    "debugger",
    "alarms",
    "storage",
    "sessions",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "XBBridge · 点开看受控标签",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
